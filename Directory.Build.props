<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- NuGet package metadata (applies to packable projects only) -->
  <PropertyGroup>
    <Authors>Adam Verner</Authors>
    <Copyright>Copyright © 2026 Adam Verner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aspnetcore;admin;panel;generator;scaffold</PackageTags>
    <PackageProjectUrl>https://github.com/averner/AdminForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/averner/AdminForge</RepositoryUrl>
  </PropertyGroup>
</Project>