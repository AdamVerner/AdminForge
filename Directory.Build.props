<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Each src project is its own package; the XML docs travel in it. Missing-doc warnings stay off. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('/src/'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Authors>Adam Verner</Authors>
    <Copyright>Copyright © 2026 Adam Verner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aspnetcore;blazor;admin;panel</PackageTags>
    <PackageProjectUrl>https://github.com/AdamVerner/AdminForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamVerner/AdminForge</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('/src/'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
