@page "/admin/status"
@using AdminForge
@using AdminForge.UI.Components
@using Microsoft.AspNetCore.Components.Web
@inject IUserAccessor User
@inject TodoApp.AuditLogStore AuditLog

@* A page of the host's own, inside the panel's shell: its theme, its sidebar, its user. *@

<PageTitle>Status</PageTitle>
<PageHeader Title="Status" />
<div class="af-panel host-note" data-af="host-page">
    <p>Signed in as <b>@(User.GetUser().Identity?.Name ?? "anonymous")</b>.</p>
    <p>@AuditLog.Snapshot().Count audit entries since start.</p>
</div>
