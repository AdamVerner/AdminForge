<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Threading TestContext's token through every call only speeds up cancelling a run. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdminForge/AdminForge.csproj" />
    <ProjectReference Include="../../src/AdminForge.Mcp/AdminForge.Mcp.csproj" />
    <ProjectReference Include="../../src/AdminForge.EntityFrameworkCore/AdminForge.EntityFrameworkCore.csproj" />
    <!-- The smoke test boots it; the panel hosts borrow its static-web-assets manifest. -->
    <ProjectReference Include="../../examples/TodoApp/TodoApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
