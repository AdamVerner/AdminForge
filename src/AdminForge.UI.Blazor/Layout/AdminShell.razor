@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminForgeOptions Options
@inject AuthenticationStateProvider AuthenticationState

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* The class appears once the circuit renders, so a browser can tell when clicks count. *@
<MudLayout Class="@(RendererInfo.IsInteractive ? "adminforge-interactive" : null)">
    <MudAppBar Elevation="1" Style="@AppBarStyle">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        @if (!string.IsNullOrWhiteSpace(Options.Theme.LogoUrl))
        {
            <MudImage Src="@Options.Theme.LogoUrl"
                      Alt="@(Options.Theme.LogoAlt ?? "Logo")"
                      Height="32"
                      Class="ml-4" />
        }
        <MudText Typo="Typo.h6" Class="ml-4">@Options.Title</MudText>
        @if (Options.Environment is { } env)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-3 adminforge-environment"
                     Style="color:inherit;border-color:currentColor">@env.Label</MudChip>
        }
        <MudSpacer />
        @if (_userName is not null)
        {
            <MudText Typo="Typo.body2" Class="mr-4">@_userName</MudText>
        }
        @if (Options.SignOutPath is not null)
        {
            <form method="post" action="@Options.SignOutPath">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
            </form>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <Sidebar />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private MudTheme _theme = default!;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true)
            _userName = user.Identity.Name;

        // Default palette: use MudBlazor's stock light palette, then override primary /
        // secondary if the host configured them. Leaving everything null keeps the
        // out-of-the-box experience untouched.
        var palette = new PaletteLight();
        if (TryParseHex(Options.Theme.PrimaryColor, out var primary))
        {
            palette.Primary = primary!;
        }
        if (TryParseHex(Options.Theme.SecondaryColor, out var secondary))
        {
            palette.Secondary = secondary!;
        }
        _theme = new MudTheme { PaletteLight = palette };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private string? AppBarStyle =>
        Options.Environment is { } env ? $"background-color:{env.Color}" : null;

    /// <summary>
    /// MudBlazor's <c>MudColor</c> implicit-converts from a hex string, but throws on
    /// invalid input. Guard so a malformed config value can't crash the shell render.
    /// </summary>
    private static bool TryParseHex(string? value, out MudBlazor.Utilities.MudColor? color)
    {
        color = null;
        if (string.IsNullOrWhiteSpace(value)) return false;
        try
        {
            color = new MudBlazor.Utilities.MudColor(value);
            return true;
        }
        catch
        {
            return false;
        }
    }
}
