@inject IAdminUIBridge Bridge
@inject AdminForgeOptions Options
@inject NavigationManager Nav

<div class="adminforge-sidebar" style="display:flex;flex-direction:column;height:100%">
    <MudNavMenu Style="flex:1 1 auto;overflow-y:auto">
        <MudNavLink Href="@RootHref" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
            Home
        </MudNavLink>
        @foreach (var group in _grouped)
        {
            if (group.Key is null)
            {
                @foreach (var entry in group.Entries)
                {
                    <MudNavLink Href="@entry.Href" Icon="@entry.Icon">@entry.Label</MudNavLink>
                }
            }
            else
            {
                <MudNavGroup Title="@group.Key" Expanded="true" Icon="@Icons.Material.Filled.Folder">
                    @foreach (var entry in group.Entries)
                    {
                        <MudNavLink Href="@entry.Href" Icon="@entry.Icon">@entry.Label</MudNavLink>
                    }
                </MudNavGroup>
            }
        }
    </MudNavMenu>
    @if (_settings.Count > 0)
    {
        <MudNavMenu Class="adminforge-settings" Style="flex:none;border-top:1px solid var(--mud-palette-divider)">
            <MudNavGroup Title="Settings" @bind-Expanded="_settingsOpen" Icon="@Icons.Material.Filled.Settings">
                @foreach (var entry in _settings)
                {
                    <MudNavLink Href="@entry.Href" Icon="@entry.Icon">@entry.Label</MudNavLink>
                }
            </MudNavGroup>
        </MudNavMenu>
    }
</div>

@code {
    private IReadOnlyList<NavGrouping.Group<NavEntry>> _grouped = [];
    private IReadOnlyList<NavEntry> _settings = [];
    private bool _settingsOpen;

    protected override async Task OnInitializedAsync()
    {
        var entries = await NavEntries.CollectAsync(Bridge, Options);
        _grouped = NavGrouping.Arrange(entries.Where(e => e.Nav.Area == NavArea.Main), e => e.Nav, e => e.Label);
        _settings = NavGrouping.Arrange(entries.Where(e => e.Nav.Area == NavArea.Settings), e => e.Nav, e => e.Label)
            .SingleOrDefault()?.Entries ?? [];
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        _settingsOpen = _settings.Any(e => path.StartsWith(e.Href, StringComparison.OrdinalIgnoreCase));
    }

    private string RootHref => "/" + Options.RoutePrefix.Trim('/');
}
