@inject IAdminUIBridge Bridge
@inject AdminForgeOptions Options

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="adminforge-account" LockScroll="true">
    <ActivatorContent>
        <button type="button" aria-label="Account menu" title="@UserName" @onclick="context.ToggleAsync"
                style="background:none;border:0;padding:0;border-radius:50%;cursor:pointer">
            <MudAvatar Size="Size.Small" Color="Color.Dark">@Initials</MudAvatar>
        </button>
    </ActivatorContent>
    <ChildContent>
        <div class="px-4 pt-3 pb-2" style="min-width:220px">
            <MudText Typo="Typo.subtitle2">@UserName</MudText>
        </div>
        @if (_entries.Count > 0)
        {
            <MudDivider />
            @foreach (var entry in _entries)
            {
                <MudMenuItem Href="@entry.Href" Icon="@entry.Icon">@entry.Label</MudMenuItem>
            }
        }
        @if (Options.SignOutPath is not null)
        {
            <MudDivider />
            <form method="post" action="@Options.SignOutPath">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Logout" Class="justify-start px-4 py-2"
                           Style="text-transform:none;font-weight:400;font-size:var(--mud-typography-body1-size)">Sign out</MudButton>
            </form>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";

    private IReadOnlyList<NavEntry> _entries = [];

    protected override async Task OnInitializedAsync()
    {
        var entries = await NavEntries.CollectAsync(Bridge, Options);
        _entries = NavGrouping.Arrange(entries.Where(e => e.Nav.Area == NavArea.Account), e => e.Nav, e => e.Label)
            .SingleOrDefault()?.Entries ?? [];
    }

    private string Initials =>
        string.Concat(UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
