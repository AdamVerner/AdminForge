@using Microsoft.AspNetCore.Components.Routing
@using AdminForge.Core.Configuration
@using AdminForge.UI.Blazor.Layout
@inject AdminForgeOptions Options

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="@HostAssemblies(Options)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(AdminShell)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(AdminShell)">
            <MudContainer Class="mt-8">
                <MudText Typo="Typo.h4">Page not found</MudText>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>

@code {
    /// <summary>The assemblies the host's own pages live in, so the router finds their routes.</summary>
    public static IEnumerable<System.Reflection.Assembly> HostAssemblies(AdminForgeOptions options) =>
        options.Pages.Select(p => p.ComponentType.Assembly).Where(a => a != typeof(Routes).Assembly).Distinct();
}
