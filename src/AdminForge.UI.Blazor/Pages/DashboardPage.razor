@page "/admin/dashboards/{RouteName}"
@inject IAdminUIBridge Bridge

<PageTitle>@(_dashboard?.Title ?? RouteName)</PageTitle>

@if (_meta is null)
{
    <MudAlert Severity="Severity.Error">Unknown dashboard '@RouteName'.</MudAlert>
}
else if (_forbidden)
{
    <MudAlert Severity="Severity.Warning">You are not allowed to open this dashboard.</MudAlert>
}
else if (_dashboard is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">@_dashboard.Title</MudText>
    <WidgetGrid Dashboard="@_dashboard" DashboardMeta="@_meta" />
}

@code {
    [Parameter] public string RouteName { get; set; } = string.Empty;

    private DashboardMeta? _meta;
    private DashboardVM? _dashboard;
    private bool _forbidden;

    protected override async Task OnParametersSetAsync()
    {
        _meta = Bridge.FindDashboardByRouteName(RouteName);
        _dashboard = null;
        _forbidden = false;
        if (_meta is null) return;
        try
        {
            _dashboard = await Bridge.LoadDashboardAsync(_meta);
        }
        catch (AdminForbiddenException)
        {
            _forbidden = true;
        }
    }
}
