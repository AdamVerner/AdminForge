@page "/admin/entities/{EntityName}/{Key}"
@implements IDisposable
@inject IAdminUIBridge Bridge
@inject NavigationManager Nav

<PageTitle>@(Entity?.Label ?? EntityName)</PageTitle>

@if (Entity is null)
{
    <MudAlert Severity="Severity.Error">Unknown entity '@EntityName'.</MudAlert>
}
else if (_view is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@Entity.Label — @_view.Key</MudText>
        @if (Entity.LivePollingInterval is { } iv)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                Live · every @((int)iv.TotalSeconds)s@(_lastRefreshedAt is { } at ? $" · {at.ToLocalTime():HH:mm:ss}" : "")
            </MudChip>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   OnClick="@(() => Nav.NavigateTo($"/admin/entities/{Entity.RouteName}"))">
            Back to list
        </MudButton>
        @if (!Entity.IsReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Nav.NavigateTo($"/admin/entities/{Entity.RouteName}/{Uri.EscapeDataString(_view.Key)}/edit"))">
                Edit
            </MudButton>
        }
    </MudStack>

    <MudCard>
        <MudCardContent>
            @foreach (var column in Entity.Columns)
            {
                if (column.Kind == ColumnKind.NavigationCollection) continue;
                if (!_view.Values.TryGetValue(column.PropertyName, out var raw)) continue;

                <MudStack Row="true" Class="mb-3">
                    <MudText Typo="Typo.subtitle2" Style="min-width:200px">@column.Label</MudText>
                    <div>@RenderValue(raw, column)</div>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>

    <RelatedLinksSection Links="_view.RelatedLinks" />
    <EntityActionsBar Entity="@Entity" EncodedKey="@_view.Key" OnInvoked="Refresh" />
}

@code {
    [Parameter] public string EntityName { get; set; } = string.Empty;
    [Parameter] public string Key { get; set; } = string.Empty;

    private EntityMeta? Entity;
    private EntityViewVM? _view;
    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;
    private string? _polledForKey;
    private DateTimeOffset? _lastRefreshedAt;

    protected override async Task OnParametersSetAsync()
    {
        Entity = Bridge.FindEntityByRouteName(EntityName);
        if (Entity is null) return;
        await Refresh();
        // (Re)start the polling loop only when the route key actually changes — a
        // re-render that supplies the same parameters must not spin up a second timer.
        var pollKey = $"{Entity.RouteName}/{Key}";
        if (Entity.LivePollingInterval is { } interval && !string.Equals(_polledForKey, pollKey, StringComparison.Ordinal))
        {
            StopPolling();
            _polledForKey = pollKey;
            _pollCts = new CancellationTokenSource();
            var token = _pollCts.Token;
            _pollTask = Task.Run(() => PollLoop(Entity, Key, interval, token));
        }
        else if (Entity.LivePollingInterval is null)
        {
            StopPolling();
            _polledForKey = null;
        }
    }

    private async Task PollLoop(EntityMeta entity, string key, TimeSpan interval, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(interval, ct).ConfigureAwait(false);
                }
                catch (OperationCanceledException)
                {
                    return;
                }
                try
                {
                    var refreshed = await Bridge.FindAsync(entity, Uri.UnescapeDataString(key), ct).ConfigureAwait(false);
                    if (refreshed is not null)
                    {
                        _view = refreshed;
                        _lastRefreshedAt = DateTimeOffset.UtcNow;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { return; }
                catch (Exception)
                {
                    // Best-effort live refresh — transient errors must not tear down the loop.
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Refresh()
    {
        if (Entity is null) return;
        _view = await Bridge.FindAsync(Entity, Uri.UnescapeDataString(Key));
        StateHasChanged();
    }

    public void Dispose() => StopPolling();

    private void StopPolling()
    {
        try
        {
            _pollCts?.Cancel();
            _pollCts?.Dispose();
        }
        catch { /* best effort */ }
        _pollCts = null;
        _pollTask = null;
    }

    private RenderFragment RenderValue(object? raw, ColumnMeta column) => builder =>
    {
        if (raw is null)
        {
            builder.AddContent(0, new MarkupString("<em>(null)</em>"));
            return;
        }
        if (raw is NavigationRef navRef)
        {
            var meta = Bridge.Entities.FirstOrDefault(e => e.Name == navRef.EntityName);
            if (meta is not null)
            {
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Href", $"/admin/entities/{meta.RouteName}/{Uri.EscapeDataString(navRef.Key)}");
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, navRef.DisplayLabel)));
                builder.CloseComponent();
                return;
            }
            builder.AddContent(0, navRef.DisplayLabel);
            return;
        }
        if (raw is IReadOnlyList<NavigationRef> navs)
        {
            var idx = 0;
            foreach (var nr in navs)
            {
                if (idx++ > 0) builder.AddContent(100 + idx, ", ");
                var meta = Bridge.Entities.FirstOrDefault(e => e.Name == nr.EntityName);
                if (meta is not null)
                {
                    builder.OpenComponent<MudLink>(200 + idx);
                    builder.AddAttribute(201 + idx, "Href", $"/admin/entities/{meta.RouteName}/{Uri.EscapeDataString(nr.Key)}");
                    builder.AddAttribute(202 + idx, "ChildContent", (RenderFragment)(b => b.AddContent(0, nr.DisplayLabel)));
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(300 + idx, nr.DisplayLabel);
                }
            }
            return;
        }
        builder.AddContent(0, raw.ToString());
    };
}
