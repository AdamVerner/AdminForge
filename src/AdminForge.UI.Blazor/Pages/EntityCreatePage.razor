@page "/admin/entities/{EntityName}/new"
@inject IAdminUIBridge Bridge
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>New @(Entity?.Label ?? EntityName)</PageTitle>

@if (Entity is null)
{
    <MudAlert Severity="Severity.Error">Unknown entity '@EntityName'.</MudAlert>
}
else if (_edit is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">New @Entity.Label</MudText>
    <EntityForm Entity="@Entity" Model="@_edit" OnSubmit="HandleSubmit" OnCancel="@Cancel" SubmitLabel="Create" IsNew="true" />
}

@code {
    [Parameter] public string EntityName { get; set; } = string.Empty;

    private EntityMeta? Entity;
    private EntityEditVM? _edit;

    protected override void OnParametersSet()
    {
        Entity = Bridge.FindEntityByRouteName(EntityName);
        if (Entity is null) return;
        _edit = Bridge.NewEditModel(Entity);
    }

    private async Task HandleSubmit()
    {
        if (Entity is null || _edit is null) return;
        try
        {
            var newKey = await Bridge.CreateAsync(Entity, _edit);
            Snackbar.Add("Created.", MudBlazor.Severity.Success);
            Nav.NavigateTo($"/admin/entities/{Entity.RouteName}/{Uri.EscapeDataString(newKey)}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Create failed: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private void Cancel()
    {
        if (Entity is null) return;
        Nav.NavigateTo($"/admin/entities/{Entity.RouteName}");
    }
}
