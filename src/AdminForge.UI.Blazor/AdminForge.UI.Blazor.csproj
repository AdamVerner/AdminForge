<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <RootNamespace>AdminForge.UI.Blazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AdminForge.Core/AdminForge.Core.csproj" />
    <ProjectReference Include="../AdminForge.DataAccess.EfCore/AdminForge.DataAccess.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MudBlazor" />
    <!--
      Ships _framework/blazor.web.js as a static web asset. The Web SDK auto-references it for
      Blazor host projects, but here the host (TodoApp) is plain Web SDK while the components
      live in this Razor-SDK library — so we add it explicitly so the asset propagates.
    -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
  </ItemGroup>
</Project>
