<MudStack Row="true" Spacing="2">
    <MudTextField T="string" Label="@Label" Value="@Value"
                  HelperText="@HelperText"
                  Error="@(Error is not null)" ErrorText="@Error"
                  Lines="8" Class="flex-grow-1"
                  Style="min-width: 240px"
                  ValueChanged="@OnChanged" />
    <MudPaper Class="pa-3 flex-grow-1" Style="min-width: 240px; max-height: 220px; overflow:auto;">
        <MudText Typo="Typo.caption">Preview</MudText>
        @if (string.IsNullOrEmpty(Value)) { <em>(empty)</em> }
        else { <MarkdownView Markdown="@Value" /> }
    </MudPaper>
</MudStack>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnChanged(string v) => ValueChanged.InvokeAsync(v);
}
