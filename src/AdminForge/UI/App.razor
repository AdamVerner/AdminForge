@inject PanelModel Panel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Theme.Stylesheet" rel="stylesheet" />
    <style>@Theme.Tokens(Panel)</style>
    @if (Panel.Theme.StylesheetUrl is { } stylesheet)
    {
        <link href="@stylesheet" rel="stylesheet" />
    }
    <script src="@Theme.Script"></script>
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>Blazor.start({ circuit: { configureSignalR: b => b.withUrl("@Hub.TrimStart('/')") } });</script>
</body>
</html>

@code {
    /// <summary>The panel's circuit endpoint, under its root rather than the framework's /_blazor.</summary>
    internal const string Hub = PanelModel.Root + "/_blazor";
}
