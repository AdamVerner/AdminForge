@inject PanelModel Model

<div class="af-panel af-stat">
    <div class="af-stat-label">@Title</div>
    @if (Error is not null)
    {
        <div class="af-inline-error" data-af="error">@Error</div>
    }
    else
    {
        <div class="af-stat-value"><strong data-af="stat">@(ValueFormatter.Format(Value, null, Model) ?? "—")</strong>@if (!string.IsNullOrEmpty(Suffix)) { <span>@Suffix</span> }</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public object? Value { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public string? Error { get; set; }
}
