@inject IDialogService Dialogs

@* A long value in a cell: one line of it, and a button that opens the whole thing. *@

@if (Whole && Kind != Content.Html)
{
    <div class="af-content-whole">
        @if (Kind == Content.Markdown)
        {
            <MarkdownView Markdown="@Value" />
        }
        else
        {
            <pre class="af-pre">@(Kind == Content.Json ? ContentDialog.Pretty(Value) : Value)</pre>
        }
    </div>
}
else
{
    <span class="af-content">
        <span title="@Preview">@Preview</span>
        <button type="button" class="af-icon-btn" aria-label="Open @Title" title="Open @Title" @onclick="Open">
            <Icon Svg="@Icons.Material.Filled.OpenInFull" />
        </button>
    </span>
}

@code {
    private const int PreviewLength = 120;

    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Content Kind { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>On a detail page: the value rendered in full, except HTML, which only the sandboxed dialog shows.</summary>
    [Parameter] public bool Whole { get; set; }

    private string Preview
    {
        get
        {
            var text = Kind == Content.Html ? System.Text.RegularExpressions.Regex.Replace(Value, "<[^>]*>", " ") : Value;
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
            return text.Length <= PreviewLength ? text : text[..PreviewLength] + "…";
        }
    }

    private Task Open() => ContentDialog.ShowAsync(Dialogs, Title, Value, Kind);
}
