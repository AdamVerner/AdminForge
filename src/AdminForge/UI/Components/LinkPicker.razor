@* Picks a row of the linked table by its label; searching and reading go through the pipeline like any list. *@
@inject AdminPanel Panel

<MudAutocomplete T="RowView" Value="_row" ValueChanged="Pick" SearchFunc="SearchAsync"
                 ToStringFunc="@(r => r?.Label ?? _unread ?? "")" UserAttributes="@_attributes"
                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" DebounceInterval="300"
                 Variant="Variant.Outlined" Margin="Margin.Dense" Error="Invalid" Placeholder="Choose…">
    <ItemTemplate Context="row">
        <span class="af-hit">@row.Label <small class="af-mono">@row.Key</small></span>
    </ItemTemplate>
    <NoItemsTemplate><div class="af-hit-state">No matches</div></NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter, EditorRequired] public string TableId { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public bool Invalid { get; set; }

    private RowView? _row;

    // The key, shown when the caller may not read the linked row; a key that matches no row (a new form's 0) shows nothing.
    private string? _unread;
    private Dictionary<string, object?> _attributes = [];

    protected override async Task OnInitializedAsync()
    {
        _attributes = new() { ["id"] = Id, ["aria-describedby"] = DescribedBy };
        if (string.IsNullOrEmpty(Value)) return;
        try
        {
            _row = (await Panel.GetAsync(TableId, Panel.Model.Table(TableId)!.Key.Encode([Value])))?.Row;
        }
        catch (AdminRejection)
        {
            _unread = Value;
        }
    }

    private async Task<IEnumerable<RowView>> SearchAsync(string? text, CancellationToken ct)
    {
        if (Panel.Model.Table(TableId)!.Searchable || string.IsNullOrWhiteSpace(text))
            return (await Panel.ListAsync(TableId, new ListRequest(PageSize: 20, Search: text), ct)).Rows;
        // The source cannot search, so the labels are matched here, over as many rows as a picker can hold.
        var rows = (await Panel.ListAsync(TableId, new ListRequest(PageSize: Panel.Model.MaxPageSize), ct)).Rows;
        return rows.Where(r => r.Label.Contains(text, StringComparison.CurrentCultureIgnoreCase)).Take(20);
    }

    private Task Pick(RowView? row)
    {
        _row = row;
        // A link's target has a one-part key; the field holds its value, not its URL-escaped form.
        return ValueChanged.InvokeAsync(row is null ? null : Uri.UnescapeDataString(row.Key));
    }
}
