@inject PanelModel Panel

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="@Panel.HostAssemblies">
    <Found Context="routeData">
        <PolicedRouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(AdminShell)">
            <PageTitle>Not found</PageTitle>
            <NotFoundState />
        </LayoutView>
    </NotFound>
</Router>
