@inject PanelModel Panel

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="@Panel.HostAssemblies" NotFoundPage="@typeof(NotFoundPage)">
    <Found Context="routeData">
        <PolicedRouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
