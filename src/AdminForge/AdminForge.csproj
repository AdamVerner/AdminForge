<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>AdminForge</PackageId>
    <Description>An admin panel for ASP.NET Core: tables over your own sources, actions, forms, dashboards, MudBlazor UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdminForge.Mcp" />
    <InternalsVisibleTo Include="AdminForge.EntityFrameworkCore" />
    <InternalsVisibleTo Include="AdminForge.Tests" />
    <InternalsVisibleTo Include="AdminForge.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Markdig" />
    <!-- Ships _framework/blazor.web.js as a static web asset; a Web SDK host gets it only for its own Razor files. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
  </ItemGroup>
</Project>
