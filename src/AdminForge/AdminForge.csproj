<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AdminForge</PackageId>
    <Version>0.2.0</Version>
    <Authors>AdminForge contributors</Authors>
    <Description>
      AdminForge auto-generates an admin panel for ASP.NET Core apps: CRUD pages for EF Core
      entities, dashboards (stat cards, line charts, table widgets), generic forms, custom
      actions, related-table links, audit log hook, per-action authorization, and live updates.
      Single NuGet, two lines of host wiring, MudBlazor-powered UI.
    </Description>
    <PackageTags>aspnetcore;blazor;admin;efcore;crud;dashboard</PackageTags>
    <IsPackable>true</IsPackable>

    <!--
      Phase 6 packaging strategy: the five sub-projects stay IsPackable=false; we ship a single
      .nupkg whose lib/net10.0/ folder carries all five DLLs (+ XML docs). Project references use
      PrivateAssets=all so MSBuild doesn't try to inflate them into NuGet package dependencies;
      runtime dependencies (MudBlazor, EF Core, etc.) are declared explicitly on the meta-package
      below so they propagate transitively to consumers.
    -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AdminForgePackSubAssemblies</TargetsForTfmSpecificContentInPackage>

    <!-- Suppress NU5131: tooling complains about unreferenced lib/ contents because the dlls
         we inject aren't built outputs of THIS project. They're built outputs of the project
         references — the injected files come from $(OutputPath) which contains them all. -->
    <NoWarn>$(NoWarn);NU5131;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Sub-project references with PrivateAssets="all" so the produced nupkg does NOT list
    AdminForge.Core, .UI.Blazor, etc. as NuGet dependencies (those package ids don't exist
    on any feed). Their compiled DLLs are shipped inline under lib/net10.0/ via the
    AdminForgePackSubAssemblies target below; a NuGet consumer who installs AdminForge
    will find AdminForge.Core types automatically because that DLL sits next to AdminForge.dll
    in the package's lib folder.

    SIDE EFFECT: in-solution ProjectReference consumers (TodoApp, integration tests)
    can no longer see sub-project types via this meta-package alone — PrivateAssets="all"
    cuts compile-time asset flow. Those consumers reference the sub-projects directly.
    See examples/TodoApp/TodoApp.csproj and tests/AdminForge.IntegrationTests/*.csproj.
  -->
  <ItemGroup>
    <ProjectReference Include="../AdminForge.Core/AdminForge.Core.csproj" PrivateAssets="all" />
    <ProjectReference
      Include="../AdminForge.DataAccess.EfCore/AdminForge.DataAccess.EfCore.csproj"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../AdminForge.LiveUpdates/AdminForge.LiveUpdates.csproj"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../AdminForge.UI.Blazor/AdminForge.UI.Blazor.csproj"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../AdminForge.Middleware/AdminForge.Middleware.csproj"
      PrivateAssets="all"
    />
  </ItemGroup>

  <!--
    Runtime dependencies that MUST propagate to consumers. MudBlazor and the ASP.NET Core
    internal-assets package ship the static web assets (blazor.web.js, _content/MudBlazor/*)
    that the rendered UI needs at runtime.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Walk the meta-package's bin/$(Configuration)/$(TargetFramework) directory and ship every
    AdminForge*.dll + matching .xml doc file under lib/net10.0/. The five sub-project DLLs land
    there because they're project references, and AdminForge.dll itself is added too. We exclude
    test/dependency DLLs because we only glob AdminForge*.{dll,xml}.
  -->
  <Target Name="AdminForgePackSubAssemblies">
    <ItemGroup>
      <!--
        Glob the SUB-PROJECT assemblies only. The meta-package's own AdminForge.dll/.xml
        is already added by the standard pack pipeline, so excluding it avoids NU5118
        duplicate-file errors.
      -->
      <_AdminForgeLibFiles Include="$(OutputPath)AdminForge.*.dll" />
      <_AdminForgeLibFiles Include="$(OutputPath)AdminForge.*.xml" />
      <TfmSpecificPackageFile Include="@(_AdminForgeLibFiles)">
        <PackagePath>lib/$(TargetFramework)/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
